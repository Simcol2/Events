{
  "crons": [
    { "path": "/api/send-review-requests", "schedule": "0 15 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/how-it-works", "destination": "/how-it-works/index.html" },
    { "source": "/experiences", "destination": "/experiences/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/decor", "destination": "/decor/index.html" },
    { "source": "/birthdays/tutu-twirls-tea", "destination": "/birthdays/tutu-twirls-tea/index.html" },
    { "source": "/milestone-events/baby-shower", "destination": "/milestone-events/baby-shower/index.html" },
    { "source": "/gifts", "destination": "/gifts/index.html" },
    { "source": "/catering", "destination": "/catering/index.html" },
    { "source": "/package-builder", "destination": "/package-builder/index.html" },
    { "source": "/display-options", "destination": "/display-options/index.html" },
    { "source": "/past-events", "destination": "/past-events/index.html" },
    { "source": "/rental-guide", "destination": "/rental-guide/index.html" },
    { "source": "/reviews", "destination": "/reviews/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
