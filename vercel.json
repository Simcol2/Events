{
  "crons": [
    { "path": "/api/send-review-requests", "schedule": "0 15 * * *" },
    { "path": "/api/square?resource=timing", "schedule": "0 16 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/events/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/events/api/:path*", "destination": "/api/:path*" },
    { "source": "/events/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/events/photos/:path*", "destination": "/photos/:path*" },
    { "source": "/events/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/events/robots.txt", "destination": "/robots.txt" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/events/how-it-works", "destination": "/how-it-works/index.html" },
    { "source": "/events/experiences", "destination": "/experiences/index.html" },
    { "source": "/events/about", "destination": "/about/index.html" },
    { "source": "/events/faq", "destination": "/faq/index.html" },
    { "source": "/events/decor", "destination": "/decor/index.html" },
    { "source": "/events/table-box", "destination": "/table-box/index.html" },
    { "source": "/events/birthdays/tutu-twirls-tea", "destination": "/birthdays/tutu-twirls-tea/index.html" },
    { "source": "/events/milestone-events/baby-shower", "destination": "/milestone-events/baby-shower/index.html" },
    { "source": "/events/gifts", "destination": "/gifts/index.html" },
    { "source": "/events/catering", "destination": "/catering/index.html" },
    { "source": "/events/package-builder", "destination": "/package-builder/index.html" },
    { "source": "/events/display-options", "destination": "/display-options/index.html" },
    { "source": "/events/past-events", "destination": "/past-events/index.html" },
    { "source": "/events/rental-guide", "destination": "/rental-guide/index.html" },
    { "source": "/events/reviews", "destination": "/reviews/index.html" },
    { "source": "/events/(.*)", "destination": "/index.html" }
  ]
}
